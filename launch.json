{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Run Model Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Run CLI Predictor",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/cli_predict.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
